<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.silk.mapper.RoomMapper">

    <resultMap id="roomResult" type="com.silk.entity.Room">
        <id property="id" column="id"/>
        <result property="buildingId" column="building_id"/>
        <result property="floor" column="floor"/>
        <result property="brand" column="brand"/>
        <result property="roomCapacity" column="room_capacity"/>
        <result property="roomType" column="room_type"/>
    </resultMap>

    <sql id="queryCondition">
        <where>
            <if test="id != null and id != ''">AND id = #{id}</if>
            <if test="buildingId != null and buildingId != ''">AND building_id = #{buildingId}</if>
            <if test="floor != null and floor != ''">AND floor = #{floor}</if>
            <if test="brand != null and brand != ''">AND brand = #{brand}</if>
            <if test="roomType != null and roomType != ''">AND room_type = #{roomType}</if>
        </where>
    </sql>

    <select id="query" resultMap="roomResult">
        SELECT * FROM tb_room
        <include refid="queryCondition"/>
        ORDER BY floor, id
    </select>

    <select id="detail" resultMap="roomResult">
        SELECT * FROM tb_room WHERE id = #{id}
    </select>

    <select id="queryLiverAmount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM tb_user WHERE room_id = #{id}
    </select>

    <select id="queryLivers" resultType="com.silk.entity.User">
        SELECT id, user_name AS userName, gender, phone, email
        FROM tb_user
        WHERE room_id = #{roomId}
        ORDER BY id
    </select>

    <insert id="insert" parameterType="com.silk.entity.Room">
        INSERT INTO tb_room (id, building_id, floor, brand, room_capacity, room_type)
        VALUES (#{id}, #{buildingId}, #{floor}, #{brand}, #{roomCapacity}, #{roomType})
    </insert>

    <update id="updateSelective" parameterType="com.silk.entity.Room">
        UPDATE tb_room
        <set>
            <if test="buildingId != null">building_id = #{buildingId},</if>
            <if test="floor != null">floor = #{floor},</if>
            <if test="brand != null and brand != ''">brand = #{brand},</if>
            <if test="roomCapacity != null">room_capacity = #{roomCapacity},</if>
            <if test="roomType != null">room_type = #{roomType},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteByIds">
        DELETE FROM tb_room WHERE id IN (${ids})
    </delete>

    <delete id="deleteByBuildingIds">
        DELETE FROM tb_room WHERE building_id IN (${ids})
    </delete>

    <update id="capacityPlusOne">
        UPDATE tb_room SET room_capacity = room_capacity + 1 WHERE id = #{id}
    </update>

    <update id="capacityMinusOne">
        UPDATE tb_room SET room_capacity = GREATEST(room_capacity - 1, 0) WHERE id = #{id}
    </update>

</mapper>
